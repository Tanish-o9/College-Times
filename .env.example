# =========================================================================
# COLLEGE TIMES - FRONTEND (CLIENT-SIDE) CONFIGURATION
# =========================================================================
# These variables prefix with VITE_ and are bundled for client-side use.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# =========================================================================
# VERCEL SERVERLESS OTP API (SERVER-SIDE ONLY) CONFIGURATION
# =========================================================================
# IMPORTANT: These do NOT have VITE_ prefixes and are 100% hidden from the browser.
# DO NOT expose service-account private keys or SMTP credentials in client code.

# --- Firebase Admin Credentials ---
FIREBASE_PROJECT_ID=college-times-9f395
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@college-times-9f395.iam.gserviceaccount.com
# Put service account private key inside double quotes. Make sure formatting (newlines) is preserved.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDh...\n-----END PRIVATE KEY-----\n"

# --- SMTP Transporter Credentials (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_auth_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# --- OTP Policy ---
OTP_SECRET=your_64_character_cryptographic_otp_hashing_secret
ALLOWED_COLLEGE_EMAIL_DOMAINS=akgec.ac.in,student.akgec.ac.in
ALLOWED_EMAIL_DOMAINS=akgec.ac.in,student.akgec.ac.in
