rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /* --------------------------------------------------------------------------
     * CANONICAL FIRESTORE SECURITY RULES - PHASE 8 MODERATION HARDENED
     * -------------------------------------------------------------------------- */

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // On create: validate keys, default role to student, points to 0
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['displayName', 'role', 'points', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.points == 0;

      // On update: owner only, role immutable, points or recentMessageTimestamps can update;
      // non-owners can only update friendsCount, followersCount, and followingCount; admins have full override.
      allow update: if (
          isOwner(userId) 
          && request.resource.data.role == resource.data.role
          // Points increment / reset validation
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'reputationPoints', 'weeklyPoints', 'monthlyPoints'])
            || (
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) 
                || (request.resource.data.points >= (resource.data.points ? resource.data.points : 0) && request.resource.data.points - (resource.data.points ? resource.data.points : 0) <= 250)
              ) &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputationPoints']) 
                || (request.resource.data.reputationPoints >= (resource.data.reputationPoints ? resource.data.reputationPoints : 0) && request.resource.data.reputationPoints - (resource.data.reputationPoints ? resource.data.reputationPoints : 0) <= 250)
              ) &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyPoints']) 
                || (request.resource.data.weeklyPoints >= (resource.data.weeklyPoints ? resource.data.weeklyPoints : 0) && request.resource.data.weeklyPoints - (resource.data.weeklyPoints ? resource.data.weeklyPoints : 0) <= 250)
                || request.resource.data.weeklyPoints == 0
              ) &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlyPoints']) 
                || (request.resource.data.monthlyPoints >= (resource.data.monthlyPoints ? resource.data.monthlyPoints : 0) && request.resource.data.monthlyPoints - (resource.data.monthlyPoints ? resource.data.monthlyPoints : 0) <= 250)
                || request.resource.data.monthlyPoints == 0
              )
            )
          )
        )
        || isAdmin()
        || (isAuthenticated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsCount', 'followersCount', 'followingCount'])
           );

      allow delete: if false;

      // Channel Read State Sub-collection: 1 per user per channel
      match /channelReadState/{channelId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['channelId', 'lastReadMessageId', 'lastReadAt'])
          && request.resource.data.channelId is string
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageId.size() <= 100;
        allow delete: if isOwner(userId);
      }

      // Personal Saved Messages Sub-collection: 1 per message per user
      match /savedMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['messageId', 'channelId', 'savedAt', 'senderId', 'senderName', 'messageType', 'previewText'])
          && request.resource.data.messageId is string
          && request.resource.data.channelId is string
          && request.resource.data.senderId is string
          && request.resource.data.senderName is string
          && request.resource.data.messageType in ['text', 'image', 'file']
          && request.resource.data.previewText is string
          && request.resource.data.previewText.size() <= 200;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      // Phase 31: Blocked Users Sub-collection
      match /blockedUsers/{blockedUid} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 31: DM Read State Sub-collection
      match /directMessageReadState/{conversationId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 33: Group Chat Read State Sub-collection
      match /groupChatReadState/{groupId} {
        allow read, create, update, delete: if true;
      }

      // Phase 37: Saved Group Moments Sub-collection
      match /savedGroupMoments/{instantId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 39: Saved Group Content Sub-collection
      match /savedGroupContent/{saveId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 39: Group Activity State Sub-collection
      match /groupActivityState/{groupId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 8: Saved Resources Sub-collection
      match /savedResources/{resourceId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 8: Preferences Sub-collection (e.g. searchHistory)
      match /preferences/{prefId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 41, 46 & 50: User Notifications Sub-collection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated();
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']);
        allow delete: if isOwner(userId);
      }

      // Phase 50: User FCM Tokens Sub-collection
      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 47: User Home Preferences Sub-collection
      match /homePreferences/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 49: User Opportunity Applications Sub-collection (Private to owner)
      match /opportunityApplications/{appId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Bookmarked/Saved Posts Sub-collection
      match /savedPosts/{postId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Phase 41: Group Notification Preferences Sub-collection
      match /groupNotificationPreferences/{groupId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 34: Group Instant Read State Sub-collection
      match /groupInstantState/{groupId} {
        allow read, create, update, delete: if true;
      }

      // Chat Notification Preferences Sub-collection: 1 per user per channel
      match /chatNotificationPreferences/{channelId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['channelId', 'muted', 'notifyMessages', 'notifyMentions', 'notifyReplies', 'notifyReactions'])
          && request.resource.data.channelId is string
          && request.resource.data.muted is bool
          && request.resource.data.notifyMessages is bool
          && request.resource.data.notifyMentions is bool
          && request.resource.data.notifyReplies is bool
          && request.resource.data.notifyReactions is bool;
        allow delete: if isOwner(userId);
      }

      // Campus Notification Preferences Sub-collection: 1 per user (campus)
      match /notificationPreferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['enabled', 'importantEnabled', 'emergencyEnabled', 'mentionsEnabled', 'repliesEnabled', 'reactionsEnabled'])
          && request.resource.data.enabled is bool
          && request.resource.data.importantEnabled is bool
          && request.resource.data.emergencyEnabled is bool
          && request.resource.data.mentionsEnabled is bool
          && request.resource.data.repliesEnabled is bool
          && request.resource.data.reactionsEnabled is bool;
        allow delete: if isOwner(userId);
      }

      // User Notification Preferences Sub-collection: Private to user owner
      match /notificationPreferences/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Feed Preferences Sub-collection: Private to user owner
      match /feedPreferences/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 33: Saved Opportunities Sub-collection (Private to user)
      match /savedOpportunities/{opportunityId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 33: Private Opportunity Application Tracking Sub-collection (Private to user)
      match /opportunityApplications/{opportunityId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Group Memberships Index: 1 per group per user
      match /groupMemberships/{groupId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId) || isAdmin();
        allow update: if false;
      }

      // User Push Tokens Sub-collection: Private to token owner, client cannot reactivate inactive tokens
      match /pushTokens/{tokenId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']) || request.resource.data.active == false);
      }

      // User Dismissed Alerts Sub-collection: Private to user
      match /dismissedAlerts/{postId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Alert Read State Sub-collection: Private to user
      match /alertReadState/{postId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Alert Interactions Sub-collection: Private to user
      match /alertInteractions/{alertId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Incident Read State Sub-collection: Private to user
      match /incidentReadState/{incidentId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User Saved Posts Sub-collection: Private to user
      match /savedPosts/{postId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Phase 56: User Activity State Sub-collection (Scoped unread counters per feature)
      match /activityState/{scope} {
        allow read: if isOwner(userId);
        // Users can reset their own scope counters; backend increments via service
        allow create, update: if isAuthenticated() 
          && (isOwner(userId) || request.auth.uid != userId)
          && request.resource.data.scope is string
          && request.resource.data.scope in ['notifications', 'messages', 'groups', 'feed', 'events'];
        allow delete: if isOwner(userId);
      }

      // Phase 45: Followers Sub-collection
      match /followers/{followerUid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isOwner(userId) || request.auth.uid == followerUid);
      }

      // Phase 45: Following Sub-collection
      match /following/{followingUid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isOwner(userId) || request.auth.uid == followingUid);
      }

      // Phase 45: Follow Requests Sub-collection
      match /followRequests/{requestUid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isOwner(userId) || request.auth.uid == requestUid);
      }
    }

    // Friend Requests Collection
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() 
        && request.resource.data.senderId == request.auth.uid 
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending';
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Friendships Collection
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uidA == request.auth.uid || resource.data.uidB == request.auth.uid || request.auth.uid in resource.data.userUids);
      allow create: if isAuthenticated() 
        && (request.resource.data.uidA == request.auth.uid || request.resource.data.uidB == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.uidA == request.auth.uid || resource.data.uidB == request.auth.uid);
    }

    // Unified Centralized Notifications Collection
    match /notifications/{notificationId} {
      allow read, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid && request.resource.data.recipientId != request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt'])
        && request.resource.data.recipientId == resource.data.recipientId;
    }

    // Campus Emergency Incidents Collection & Updates Sub-collection
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /updates/{updateId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }

    // Student Campus Incident Reports Collection
    match /incidentReports/{reportId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() 
        && request.resource.data.reporterId == request.auth.uid 
        && request.resource.data.status == 'pending';
      allow update: if (isAuthenticated() 
        && resource.data.reporterId == request.auth.uid 
        && resource.data.status == 'pending' 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedBy', 'severity', 'incidentId', 'alertId']))) 
        || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.reporterId == request.auth.uid && resource.data.status == 'pending') || isAdmin();
    }

    // Active Campus Alerts Index Collection
    match /activeAlerts/{postId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Verified Campus Broadcasts Collection
    match /campusBroadcasts/{incidentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Aggregate Alert Metrics Collection (Admin read, authenticated atomic increment)
    match /alertMetrics/{alertId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // FCM Notification Delivery Idempotency Log (Admin-only read, client write blocked)
    match /notificationsDelivery/{postId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin Audit Logs Collection (Admin-only read, admin/backend write, immutable)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['actorId', 'action', 'targetId', 'timestamp']);
      allow update, delete: if false;
    }



    // Posts Collection & Sub-collections (Likes, Comments, Reports)
    match /posts/{postId} {
      // Auto-hide moderation (single doc get vs list query compatibility)
      allow get: if isAuthenticated() && (
        !('groupId' in resource.data) ||
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.visibility != 'private' ||
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)) ||
        isAdmin()
      ) && (!('reportCount' in resource.data) || resource.data.reportCount < 5 || isAdmin());
      allow list: if isAuthenticated();

      // Field-level data validation & author ownership on create
      allow create: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['title', 'content', 'authorId', 'authorName', 'category', 'timestamp', 'likeCount', 'commentCount', 'reportCount', 'status', 'postType'])
        && request.resource.data.authorId == request.auth.uid
        && (
          !('groupId' in request.resource.data) ||
          exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        )
        && request.resource.data.category in ['Mishap', 'Event', 'General', 'LostFound']
        && request.resource.data.postType in ['news', 'lost', 'found']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && (!('priority' in request.resource.data) || request.resource.data.priority != 'emergency' || isAdmin())
        && (!('contactInfo' in request.resource.data) || (request.resource.data.contactInfo is string && request.resource.data.contactInfo.size() <= 20));

      // Update: admin bypass, user counter increments, or author status/title/content/images resolve
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount', 'commentCount', 'reportCount', 'poll']) ||
        (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'images', 'imageUrl', 'title', 'content', 'category', 'isEdited', 'editedAt', 'poll']))
      );

      // Delete: post author or admin only
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Likes Sub-collection
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      }

      // Comments Sub-collection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() 
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'timestamp'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Poll Votes Sub-collection
      match /pollVotes/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && userId == request.auth.uid;
        allow delete: if false;
      }

      // Post Reactions Sub-collection
      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }

      // Reports Sub-collection
      match /reports/{reporterId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() 
          && reporterId == request.auth.uid
          && request.resource.data.keys().hasAll(['reporterId', 'reason', 'reportedAt']);
        allow delete: if isAdmin();
        allow update: if false;
      }

      // Phase 30: Lost & Found Claims Sub-collection
      match /claims/{claimantId} {
        allow read: if isAuthenticated() && (
          claimantId == request.auth.uid ||
          resource.data.itemReporterId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isAuthenticated() && claimantId == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Phase 30: Private Verification Details Sub-collection
      match /privateVerification/{docId} {
        allow read, write: if isAuthenticated() && (
          resource.data.reporterId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Campus Events Collection
    match /events/{eventId} {
      allow read: if isAuthenticated() && (
        !('groupId' in resource.data) ||
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.visibility != 'private' ||
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title', 'description', 'location', 'eventDate', 'createdBy', 'rsvpCount', 'createdAt'])
        && (
          !('groupId' in request.resource.data) ||
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['rsvpCount', 'interestedCount']) &&
          (!('rsvpCount' in request.resource.data) || request.resource.data.rsvpCount >= 0) &&
          (!('interestedCount' in request.resource.data) || request.resource.data.interestedCount >= 0)
        )
      );
      allow delete: if isAdmin() || (resource.data.createdBy == request.auth.uid);

      // Event RSVPs / Attendees Sub-collection
      match /rsvps/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }

      match /attendees/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }

      // Event Reminders Sub-collection
      match /reminders/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }
    }

    // Phase 31: Campus Marketplace Collection
    match /marketplaceListings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title', 'description', 'category', 'price', 'condition', 'sellerId', 'status', 'createdAt'])
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.sellerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'interestCount', 'saveCount', 'viewCount', 'reportCount'])
      );
      allow delete: if isAdmin() || (resource.data.sellerId == request.auth.uid);

      // Listing Reports Sub-collection
      match /reports/{reporterId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated() && reporterId == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Listing Interests Sub-collection
      match /interests/{userId} {
        allow read, create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }

      // Listing Offers Sub-collection
      match /offers/{offerId} {
        allow read: if isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.buyerId;
        allow delete: if isAdmin() || (resource.data.sellerId == request.auth.uid);
      }
    }

    // Phase 33: Campus Opportunities Collection
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title', 'organizationName', 'type', 'createdBy', 'status', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'saveCount', 'viewCount', 'applicationCount', 'reportCount'])
      );
      allow delete: if isAdmin() || (resource.data.createdBy == request.auth.uid);

      // Opportunity Reports Sub-collection
      match /reports/{reporterId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated() && reporterId == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Opportunity Reminders Sub-collection
      match /reminders/{userId} {
        allow read, create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['recipientId', 'message', 'read', 'timestamp']);
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.recipientId == request.auth.uid 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Phase 30: Secure Email OTP Challenge Collection (Cloud Functions Admin Only)
    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Phase 31: Private Conversations Collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participantIds 
        && request.resource.data.participantIds.size() == 2;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Private Messages Sub-collection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts'])
          )
        );
        allow delete: if false;

        // Emoji Reactions Subcollection
        match /reactions/{userId} {
          allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
          allow write: if isAuthenticated() 
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            && request.auth.uid == userId;
        }
      }
    }

    // Phase 32: Campus 24-Hour Stories Collection
    match /stories/{storyId} {
      allow read: if isAuthenticated() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() 
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'mediaType', 'status', 'createdAt', 'expiresAt']);
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount', 'reactionCount', 'replyCount'])
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Story Views Sub-collection
      match /views/{userId} {
        allow read, create: if isAuthenticated() && (
          userId == request.auth.uid ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
      }

      // Story Reactions Sub-collection
      match /reactions/{userId} {
        allow read, create, update, delete: if isAuthenticated() && userId == request.auth.uid;
      }
    }

    // Bug Reports Collection
    match /bugReports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['userId', 'userEmail', 'description', 'createdAt', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    // Chat Moderation Reports Top-Level Index
    match /chatReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Community Channels & Scalable Chat Sub-collections
    match /channels/{channelId} {
      allow read: if isAuthenticated() && (
        !channelId.startsWith('group-') ||
        exists(path('/databases/' + database + '/documents/groups/' + resource.data.groupId + '/members/' + request.auth.uid)) ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        channelId.startsWith('group-') &&
        exists(path('/databases/' + database + '/documents/groups/' + request.resource.data.groupId + '/members/' + request.auth.uid)) &&
        request.resource.data.keys().hasAll(['name', 'description', 'category', 'type', 'createdAt', 'createdBy', 'memberCount', 'isArchived'])
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'lastMessageAt']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount']) ||
          request.resource.data.memberCount == resource.data.memberCount + 1 ||
          request.resource.data.memberCount == resource.data.memberCount - 1
        )
      );
      allow delete: if isAdmin();

      // Members Sub-collection: UID matching, muted protection, announcement protection
      match /members/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() 
          && request.auth.uid == userId
          && (channelId != 'admin-announcements' || isAdmin());
        allow delete: if isAuthenticated() 
          && request.auth.uid == userId
          && (channelId != 'admin-announcements' || isAdmin());
        allow update: if isAuthenticated() && (
          isAdmin() || 
          (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['muted']))
        );
      }

      // Messages Sub-collection: Bounded content length, member & mute check
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          !channelId.startsWith('group-') ||
          exists(path('/databases/' + database + '/documents/groups/' + get(/databases/$(database)/documents/channels/$(channelId)).data.groupId + '/members/' + request.auth.uid)) ||
          isAdmin()
        );
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasAll(['channelId', 'senderId', 'senderName', 'senderRole', 'status', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && (
            !('content' in request.resource.data) ||
            (request.resource.data.content is string && request.resource.data.content.size() <= 1000)
          )
          && (
            !('attachment' in request.resource.data) || (
              request.resource.data.attachment is map &&
              request.resource.data.attachment.name is string &&
              request.resource.data.attachment.size is number &&
              request.resource.data.attachment.size <= 10485760
            )
          )
          && (
            exists(/databases/$(database)/documents/channels/$(channelId)/members/$(request.auth.uid)) || isAdmin() || channelId == 'load-test-channel'
          )
          && (
            !exists(/databases/$(database)/documents/channels/$(channelId)/members/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/channels/$(channelId)/members/$(request.auth.uid)).data.muted != true
          )
          && (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'announcement' || isAdmin());

        allow update: if isAuthenticated() && (
          // Case 1: Student editing own active message text within 15 mins
          (
            resource.data.senderId == request.auth.uid &&
            resource.data.status == 'active' &&
            request.resource.data.status == 'active' &&
            request.time - resource.data.createdAt <= duration.value(15, 'm') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt', 'updatedAt'])
          ) ||
          // Case 2: Soft delete (Owner or Admin)
          (
            (resource.data.senderId == request.auth.uid || isAdmin()) &&
            resource.data.status != 'deleted' &&
            request.resource.data.status == 'deleted' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt', 'deletedBy', 'updatedAt'])
          ) ||
          // Case 3: Reaction counts & moderation report updates
          isAdmin() ||
          channelId == 'load-test-channel' ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCounts', 'reportCount', 'status'])
        );

        allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin() || channelId == 'load-test-channel');

        // Chat Message Reports Sub-collection (1 per reporterId)
        match /reports/{reporterId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() 
            && reporterId == request.auth.uid
            && request.resource.data.keys().hasAll(['reporterId', 'reason', 'createdAt']);
          allow update, delete: if isAdmin();
        }

        // Reactions Sub-collection: 1 reaction document per user per message
        match /reactions/{uid} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() 
            && request.auth.uid == uid
            && (
              exists(/databases/$(database)/documents/channels/$(channelId)/members/$(request.auth.uid)) || isAdmin()
            );
        }
      }

      // Ephemeral Typing Sub-collection
      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && userId == request.auth.uid;
      }

      // Phase 42: Pinned Chat Messages Sub-collection
      match /pinnedMessages/{messageId} {
        allow read, create, update, delete: if isAuthenticated();
      }
    }

    // Phase 48: Marketplace Offers Collection
    match /marketplaceOffers/{offerId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.buyerId;
      allow update, delete: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Phase 49: Referral Requests Collection
    match /referralRequests/{requestId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Feature Flags Collection (Admin write only, Authenticated read)
    match /featureFlags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Phase 45: Unique Usernames Collection
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Phase 32: Group Invite Pass Codes Collection
    match /groupInviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Phase 32: Campus Groups Collection & Sub-collections
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'updatedAt']) ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']) ||
        (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCodePlaintext', 'inviteCodeHash', 'inviteCodeVersion', 'inviteEnabled']))
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'])
      );

      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          memberUid == request.auth.uid ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'])
        );
        allow update: if isAuthenticated() && (
          (memberUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'weeklyPoints', 'monthlyPoints', 'lastPointsUpdateWeek', 'lastPointsUpdateMonth', 'updatedAt'])) ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'])
        );
        allow delete: if isAuthenticated() && (
          memberUid == request.auth.uid ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'])
        );
      }

      // Phase 34, 36A & 37: Group Instants / Permanent Moments Sub-collection
      match /instants/{instantId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility != 'private' ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );

        match /media/{mediaId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && (
            exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
            isAdmin()
          );
        }

        match /comments/{commentId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && (
            exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
            isAdmin()
          );
        }

        match /reports/{reporterId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && reporterId == request.auth.uid;
        }
      }

      // Phase 35: Group Join Requests Sub-collection
      match /joinRequests/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow create: if isAuthenticated() && uid == request.auth.uid;
        allow delete: if isAuthenticated() && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          (uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'cancelled') ||
          isAdmin()
        );
      }

      // Phase 35: Group Announcements Sub-collection
      match /announcements/{announcementId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility != 'private' ||
          isAdmin()
        );
        allow create, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCounts', 'status']) ||
          isAdmin()
        );

        match /reads/{userId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
        }

        match /reactions/{userId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && userId == request.auth.uid;
        }
      }

      // Phase 35 & 37: Group Member Reports & Moderation Logs
      match /memberReports/{reportId} {
        allow read, create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
      }

      match /moderationLogs/{logId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
      }

      // Phase 35 & 37: Group Banned Members Sub-collection
      match /bannedMembers/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid ||
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
      }

      // Phase 35: Group Audit Logs Sub-collection
      match /auditLogs/{logId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow create, update, delete: if isAdmin();
      }

      // Phase 39: Group Activity Timeline Sub-collection
      match /activity/{activityId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility != 'private' ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.resource.data.actorId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }

      // Group Resources Sub-collection
      match /resources/{resourceId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility != 'private' ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount', 'downloadCount', 'reactionCounts', 'rating', 'ratingCount']) ||
          isAdmin()
        );

        match /ratings/{userId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && userId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // Collaborative Tasks Sub-collection
      match /tasks/{taskId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Shared Files Sub-collection
      match /files/{fileId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.uploadedBy == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
        allow update: if false;
      }

      // Phase 39: Group Pinned Content Sub-collection
      match /pinnedItems/{pinId} {
        allow read: if isAuthenticated() && (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility != 'private' ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'] ||
          isAdmin()
        );
      }
    }

    // -------------------------------------------------------------------------
    // Root Notifications Collection (backward compat dual-write)
    // Only the recipient can read or update; only authenticated users can create
    // -------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt']);
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Stories Collection
    // -------------------------------------------------------------------------
    match /stories/{storyId} {
      // Campus stories visible to all authenticated users (privacy filter done client-side)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Story Views: any authenticated user may record their own view
      match /views/{viewerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && viewerId == request.auth.uid;
        allow update, delete: if false;
      }

      // Story Reactions: one reaction per user
      match /reactions/{reactorId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && reactorId == request.auth.uid;
        allow delete: if isAuthenticated() && reactorId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // Conversations: only participants can access
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if isAuthenticated()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'content', 'deletedAt', 'reactionCounts']);
        allow delete: if false;

        match /reactions/{reactorId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && reactorId == request.auth.uid;
        }
      }
    }

    // -------------------------------------------------------------------------
    // Reports Collection Rules
    // -------------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Audit Logs Collection Rules (Immutable)
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.moderatorId == request.auth.uid;
      allow update, delete: if false; // Immutable!
    }

    // =========================================================================
    // PHASE 4 — ENGAGEMENT, PERSONALIZATION & DISCOVERY 2.0
    // =========================================================================

    // -------------------------------------------------------------------------
    // Reactions 2.0 — posts/{postId}/likes/{userId}
    // -------------------------------------------------------------------------
    match /posts/{postId}/likes/{userId} {
      // Any authenticated user can read reactions
      allow read: if isAuthenticated();
      // Only the reaction owner can create/update/delete their own reaction
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['type', 'likedAt'])
        && request.resource.data.type in ['like', 'love', 'celebrate', 'support', 'insightful'];
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Comment replies are already stored in posts/{postId}/comments subcollection
    // They use parentCommentId field. The existing comment rules cover this.
    // Ensure comment mentions field is allowed: nothing to add for security rules
    // since it's just an extra field on the comment document.
    // -------------------------------------------------------------------------

    // -------------------------------------------------------------------------
    // Recently Viewed — users/{userId}/recentlyViewed/{entityId}
    // -------------------------------------------------------------------------
    match /users/{userId}/recentlyViewed/{entityId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Activity Signals — users/{userId}/activitySignals/{signalId}
    // -------------------------------------------------------------------------
    match /users/{userId}/activitySignals/{signalId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['signalType', 'entityId', 'timestamp']);
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Notification Preferences — users/{userId}/notificationPreferences/settings
    // Already handled under users/{userId} but this covers the sub-document path
    // -------------------------------------------------------------------------
    match /users/{userId}/notificationPreferences/{settingDoc} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Opportunity Applications — users/{userId}/opportunityApplications/{opportunityId}
    // -------------------------------------------------------------------------
    match /users/{userId}/opportunityApplications/{opportunityId} {
      allow read, write: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Marketplace Alerts — users/{userId}/marketplaceAlerts/{alertId}
    // -------------------------------------------------------------------------
    match /users/{userId}/marketplaceAlerts/{alertId} {
      allow read, write: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // User Restriction Appeals — appeals/{appealId}
    // -------------------------------------------------------------------------
    match /appeals/{appealId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collaborative Projects Workspaces — projects/{projectId}
    // -------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      match /tasks/{taskId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // -------------------------------------------------------------------------
    // Campus Challenges — challenges/{challengeId}
    // -------------------------------------------------------------------------
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /participants/{uid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && uid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // User Challenge Progress & Reputation History
    // -------------------------------------------------------------------------
    match /users/{userId}/challengeProgress/{challengeId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/reputationHistory/{historyId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Campus Feedback System — feedback/{feedbackId}
    // -------------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Polls & Voting 2.0 — polls/{pollId}
    // -------------------------------------------------------------------------
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /votes/{uid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && uid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // Subjects & Academic Hub — subjects/{subjectId}
    // -------------------------------------------------------------------------
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || resource.data.uploaderId == request.auth.uid;
      }

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin() || resource.data.uploaderId == request.auth.uid;

        match /answers/{answerId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
          allow update, delete: if isAdmin() || resource.data.uploaderId == request.auth.uid;
        }
      }
    }

    // -------------------------------------------------------------------------
    // Support Ticket System — supportTickets/{ticketId}
    // -------------------------------------------------------------------------
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // -------------------------------------------------------------------------
    // Student Identity Verification — verificationRequests/{requestId}
    // -------------------------------------------------------------------------
    match /verificationRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Campus Activities (Phase 26)
    // -------------------------------------------------------------------------
    match /campusActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // User Notification Subcollection & Opportunity Application Subcollection
    // -------------------------------------------------------------------------
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/opportunityApplications/{opportunityId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

  }
}
