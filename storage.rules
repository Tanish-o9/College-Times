rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User Uploaded Post Photos Path: posts/{userId}/{filename}
    match /posts/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // User Uploaded Multi-Image Post Media Path: postMedia/{userId}/{postId}/{filename}
    match /postMedia/{userId}/{postId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Phase 31: Private DM Media Path: dmMedia/{conversationId}/{userId}/{filename}
    match /dmMedia/{conversationId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Phase 32: Campus Story Media Path: storyMedia/{userId}/{storyId}/{filename}
    match /storyMedia/{userId}/{storyId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // User Uploaded Chat Files Path: chatFiles/{channelId}/{userId}/{filename}
    match /chatFiles/{channelId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
          request.resource.contentType == 'application/vnd.ms-excel' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
          request.resource.contentType == 'application/vnd.ms-powerpoint' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ||
          request.resource.contentType == 'text/plain' ||
          request.resource.contentType == 'text/csv' ||
          request.resource.contentType == 'application/zip' ||
          request.resource.contentType == 'application/octet-stream'
        );
    }

    // User Uploaded Incident Evidence Path: incidentEvidence/{reportId}/{userId}/{filename}
    match /incidentEvidence/{reportId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'video/mp4' ||
          request.resource.contentType == 'video/webm'
        );
    }
    // User Uploaded Group Media Path: groupMedia/{groupId}/{userId}/{filename}
    match /groupMedia/{groupId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Phase 42: User Uploaded Group Chat Media Path: groupChatMedia/{groupId}/{userId}/{filename}
    match /groupChatMedia/{groupId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
    }
    // User Uploaded Event Media Path: eventMedia/{eventId}/{userId}/{filename}
    match /eventMedia/{eventId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // User Uploaded Lost & Found Media Path: lostFoundMedia/{itemId}/{userId}/{filename}
    match /lostFoundMedia/{itemId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // User Uploaded Marketplace Media Path: marketplaceMedia/{listingId}/{sellerId}/{filename}
    match /marketplaceMedia/{listingId}/{sellerId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == sellerId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // User Uploaded Opportunity Media Path: opportunityMedia/{opportunityId}/{userId}/{filename}
    match /opportunityMedia/{opportunityId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }
    // Phase 34 & Instant Group Moments Path: groupInstantMedia/{groupId}/{userId}/{instantId}/{filename}
    match /groupInstantMedia/{groupId}/{userId}/{instantId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 30 * 1024 * 1024;
    }
  }
}
